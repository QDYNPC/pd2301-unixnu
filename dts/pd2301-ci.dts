					type = "delay,usleep\021000 21100\0gpio,low\0qcom,platform-reset-gpio\0delay,usleep\015000 15100\0regulator,disable\0regulator_vci_3p1v\0delay,usleep\05000 5100\0gpio,low\0qcom,platform-vddr-en-gpio\0delay,usleep\05000 5100";
				};

				vivo_panel_reset {
					type = "gpio,high\0qcom,platform-reset-gpio\0delay,usleep\013000 13100\0gpio,low\0qcom,platform-reset-gpio\0delay,usleep\03000 3100\0gpio,high\0qcom,platform-reset-gpio\0delay,usleep\013000 13100";
