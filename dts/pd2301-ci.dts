			qcom,codec-lpass-clk-id = <0x316>;
			qcom,codec-lpass-ext-clk-freq = <0x124f800>;
			qcom,codec-ext-clk-src = <0x0f>;
			compatible = "qcom,audio-ref-clk";
			status = "disabled";
		};

		rx_mclk2_2x_clk {
			phandle = <0x64d>;
			#clock-cells = <0x01>;
			qcom,codec-lpass-clk-id = <0x318>;
			qcom,codec-lpass-ext-clk-freq = <0x124f800>;
			qcom,codec-ext-clk-src = <0x10>;
			compatible = "qcom,audio-ref-clk";
		};

		clock_audio_sec {
			phandle = <0x689>;
			#clock-cells = <0x01>;
			pinctrl-1 = <0x2a9>;
			pinctrl-0 = <0x2aa>;
			pinctrl-names = "active\0sleep";
			qcom,use-pinctrl = <0x01>;
			qcom,codec-lpass-clk-id = <0x301>;
			qcom,codec-lpass-ext-clk-freq = <0x124f800>;
			qcom,codec-ext-clk-src = <0x03>;
			compatible = "qcom,audio-ref-clk";
			status = "disabled";
		};

		vivo-codec-common {
			pinctrl-0 = <0x687 0x688>;
			pinctrl-names = "default";
			compatible = "vivo,vivo-codec-common";
		};

		hifi_1v8@0 {
			phandle = <0x70c>;
			enable-active-high;
			startup-delay-us = <0x3e8>;
			gpio = <0x3c 0x80 0x00>;
			regulator-max-microvolt = <0x1b7740>;
			regulator-min-microvolt = <0x1b7740>;
			regulator-name = "hifi_1v8";
			compatible = "regulator-fixed";
			status = "disabled";
		};

		hifi-codec {
			phandle = <0x70d>;
			clocks = <0x689 0x00>;
			clock-names = "hifi_mclk";
			compatible = "vivo,hifi-codec-pd1805";
			status = "disabled";
		};
	};

